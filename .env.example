# [REQUIRED] Google Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] AI Models Configuration
EMBEDDING_MODEL=gemini-embedding-001
GENERATION_MODEL=gemini-3.1-flash-lite

# [OPTIONAL] Server Configuration
HOST=127.0.0.1
PORT=8000

# [OPTIONAL] MongoDB Atlas (Only needed if you want cloud vector database storage)
# If left empty, the RAG engine will use the built-in, zero-setup In-Memory vector store.
MONGO_URL=
DB_NAME=rag_db
VECTOR_COLLECTION=vector_documents
